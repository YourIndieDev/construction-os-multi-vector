# Construction OS Multi-Vector MVP Configuration
# Copy this file to .env and customize as needed.

# =============================================================================
# REQUIRED
# =============================================================================

CONSTRUCTION_OS_ENCRYPTION_KEY=change-me-to-a-secret-string

# =============================================================================
# ISOLATED LOCAL PORTS
# =============================================================================

# These defaults avoid colliding with a normal Construction OS installation.
MULTIVECTOR_SURREAL_PORT=8001
MULTIVECTOR_QDRANT_PORT=6333
MULTIVECTOR_COLSMOL_PORT=8091
MULTIVECTOR_WEB_PORT=8503
MULTIVECTOR_API_PORT=5056

# =============================================================================
# DATABASE
# =============================================================================

SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=construction_os_multivector
SURREAL_DATABASE=construction_os_multivector

# =============================================================================
# MULTI-VECTOR MVP
# =============================================================================

# Keeps the feature optional in code while enabling it in this experimental stack.
CONSTRUCTION_OS_MULTIVECTOR_ENABLED=true
QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT_SECONDS=5
# QDRANT_API_KEY=

# Local GPU model service. Defaults target an 8 GB NVIDIA laptop GPU.
COLSMOL_URL=http://colsmol:8000
COLSMOL_TIMEOUT_SECONDS=10
COLSMOL_MODEL=vidore/colSmol-256M
COLSMOL_DTYPE=float16
COLSMOL_REQUIRE_CUDA=true
COLSMOL_MAX_IMAGE_EDGE=1536
COLSMOL_MAX_UPLOAD_BYTES=26214400

# =============================================================================
# OPTIONAL: AI Provider API Keys
# =============================================================================
# Configure these through the UI when possible.

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# GROQ_API_KEY=gsk-...

# =============================================================================
# OPTIONAL: Opportunity Hub
# =============================================================================

# SAM_GOV_API_KEY=...
# OPPORTUNITY_MONITOR_WATCHING_MINUTES=1440
# OPPORTUNITY_MONITOR_PURSUING_MINUTES=360
# OPPORTUNITY_MONITOR_SUBMITTED_MINUTES=1440
# OPPORTUNITY_MONITOR_URGENT_MINUTES=120
# OPPORTUNITY_MONITOR_SCHEDULER_SECONDS=60

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# API_URL=http://localhost:5056
# OLLAMA_BASE_URL=http://ollama:11434
# CONSTRUCTION_OS_CHUNK_SIZE=400
# CONSTRUCTION_OS_CHUNK_OVERLAP=60
# CONSTRUCTION_OS_PASSWORD=your-secure-password
# A2UI_CHAT_ENABLED=true
# NEXT_PUBLIC_A2UI_CHAT=1
